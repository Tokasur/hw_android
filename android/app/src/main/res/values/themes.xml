<resources>
    <style name="Theme.Hedgewars" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/hw_background</item>
    </style>

    <style name="Theme.Hedgewars.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/hw_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Hedgewars</item>
    </style>

    <!-- Fullscreen theme for the SDL game activity -->
    <style name="Theme.Hedgewars.Game" parent="android:Theme.Material.NoActionBar.Fullscreen">
        <item name="android:windowBackground">@android:color/black</item>
    </style>
</resources>
