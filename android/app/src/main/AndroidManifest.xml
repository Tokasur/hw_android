<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Required for the loopback TCP socket between frontend and engine
         (engine IPC) and for downloading community content packs over
         HTTPS from hedgewars.org (the in-app "Downloadable content"
         screen). No telemetry, no ads. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Gamepads are optional -->
    <uses-feature
        android:name="android.hardware.gamepad"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <application
        android:name=".HWApplication"
        android:allowBackup="true"
        android:appCategory="game"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:isGame="true"
        android:localeConfig="@xml/locales_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Hedgewars.Splash"
        tools:targetApi="26">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Hedgewars.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The SDL/engine activity. Separate process so that each match gets
             a pristine Pascal global state and an engine crash can never take
             the frontend down. -->
        <activity
            android:name=".game.GameActivity"
            android:autoRemoveFromRecents="true"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
            android:excludeFromRecents="true"
            android:exported="false"
            android:hardwareAccelerated="true"
            android:launchMode="singleTask"
            android:preferMinimalPostProcessing="true"
            android:process=":game"
            android:screenOrientation="sensorLandscape"
            android:theme="@style/Theme.Hedgewars.Game" />
    </application>
</manifest>
